{
  "name": "meexuu-senas-y-sonrisas-backend",
  "version": "1.0.0",
  "description": "Servidor API RESTful para la plataforma interactiva Señas y Sonrisas (LSM y Articulación Oral bajo MEEXUU Framework - Clave TSI-2026-MEEXUU)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node dist/scripts/migrate.js"
  },
  "keywords": [
    "MEEXUU",
    "LSM",
    "Hipoacusia",
    "Accesibilidad",
    "WCAG-2.2-AAA",
    "DUA",
    "Express",
    "TypeScript",
    "PostgreSQL"
  ],
  "author": "Equipo ARDITAS (Campos, Calderón, Castillo, Rodríguez, Moreno)",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
